<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Macro Timeline"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tv_main_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full range contribution matrix"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"/>

    <!-- Calendar card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="12dp">

        <!-- Month label row — one cell per week column, same width as dot cells -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_month_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>

        <!-- Dot grid — 7 rows × N week columns -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calendar_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btn_edit_range"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Modify Calendar Range"
        android:backgroundTint="#FFFFFF"
        android:textColor="#121212"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

</LinearLayout>